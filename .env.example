# Copy this file's values into Vercel → Project → Settings →
# Environment Variables (not into a committed .env file).

# Required for the growth-diagnosis form (app/api/diagnosis/route.ts) to
# actually deliver submissions by email instead of silently discarding them.
# Get a free API key at https://resend.com after signing up.
RESEND_API_KEY=

# The inbox that should receive new diagnosis-form submissions.
DIAGNOSIS_NOTIFY_EMAIL=

# Optional. Defaults to Resend's shared "onboarding@resend.dev" sender,
# which works immediately with no setup. Once a sending domain is verified
# in Resend, point this at a real address on that domain instead
# (e.g. "GRION <hello@grioncompany.com>").
RESEND_FROM_EMAIL=

# Optional. The site's canonical production URL, used for SEO/OG tags.
# Defaults to the current vercel.app deployment URL if unset — set this
# once a custom domain is connected.
NEXT_PUBLIC_SITE_URL=
