# Vercel → Project → Settings → Environment Variables 에 입력하세요.
# (이 파일은 값이 없는 템플릿입니다. 실제 값을 여기 적지 마세요.)

# ── 구글 시트 수집 (권장) ──────────────────────────────
# 설정 방법: docs/google-sheets.md 참고
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# ── 이메일 알림 (선택) ────────────────────────────────
# resend.com 무료 가입 후 발급
RESEND_API_KEY=
DIAGNOSIS_NOTIFY_EMAIL=
# 비워두면 Resend 공용 발신주소 사용. 도메인 인증 후 실제 주소로 교체
RESEND_FROM_EMAIL=

# ── SEO ──────────────────────────────────────────────
# 최종 사이트 주소. 비워두면 현재 vercel.app 주소를 기본값으로 사용
NEXT_PUBLIC_SITE_URL=
